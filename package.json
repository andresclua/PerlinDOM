{
    "name": "@andresclua/perlindom",
    "private": false,
    "version": "0.1.1",
    "description": "A lightweight JavaScript library for creating smooth, organic animations for DOM elements using Perlin noise",
    "homepage": "https://perlindom.js.org",
    "repository": { "type": "git", "url": "git+https://github.com/andresclua/PerlinDOM.git" },
    "bugs": "https://github.com/andresclua/PerlinDOM/issues",
    "files": ["dist", "CHANGELOG.md"],
    "type": "module",
    "main": "./dist/perlindom.umd.js",
    "module": "./dist/perlindom.es.js",
    "exports": {
        ".": {
            "import": "./dist/perlindom.es.js",
            "require": "./dist/perlindom.umd.js"
        }
    },
    "keywords": [
        "animation",
        "perlin",
        "noise",
        "dom",
        "javascript",
        "motion",
        "ui"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:lib": "vite build",
        "build:site": "vite build --mode site",
        "preview": "vite preview",
        "test": "node --test 'tests/*.test.mjs'"
    },
    "devDependencies": {
        "gsap": "^3.15.1",
        "sass": "^1.80.6",
        "vite": "^5.4.10"
    }
}
